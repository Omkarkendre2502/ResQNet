# ResQNet Server Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resqnet
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=2h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional first-run admin bootstrap (only if no admin exists yet)
# Delete ADMIN_PASSWORD from .env immediately after initial startup
# ADMIN_NAME="System Administrator"
# ADMIN_EMAIL="admin@yourdomain.com"
# ADMIN_PASSWORD="ChangeMeImmediately123!#"
